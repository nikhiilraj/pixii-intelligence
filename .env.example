# Pixii Intelligence — required environment variables.
#
# Locally, .env is a SYMLINK to ~/Nikhil-workshop/.env so credentials have a single
# source of truth and are never duplicated into this repo:
#
#   ln -s ~/Nikhil-workshop/.env ~/pixii-intelligence/.env
#
# When deployed, set these as real environment variables. Never commit a populated .env.

DATABASE_URL=postgresql+psycopg://pixii:pixii@localhost:5433/pixii_intelligence

# Zernio (the GetLate rebrand) — scheduling and post analytics.
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://getlate.dev/api/v1
GETLATE_LINKEDIN_ID=

# Azure OpenAI — primary LLM for generation and template extraction.
AZURE_OPENAI_CHAT_ENDPOINT=
AZURE_OPENAI_CHAT_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_CHAT_API_VERSION=

# Search — required only when the editorial research floor selects light or deep. Firecrawl is
# preferred when both keys are configured; Brave remains a fallback.
# `none` flows do not call a search provider. A factual flow with no key stops in a persisted
# failed research state; it is never silently downgraded.
FIRECRAWL_API_KEY=
FIRECRAWL_SEARCH_ENDPOINT=https://api.firecrawl.dev/v2/search
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search

# Azure OpenAI — image generation for visual templates with renderer "ai".
AZURE_OPENAI_IMAGE_ENDPOINT=
AZURE_OPENAI_IMAGE_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=
AZURE_OPENAI_IMAGE_API_VERSION=

# Cloudflare Browser Rendering — HTML to PNG for visual templates with renderer "html".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RENDERING_TOKEN=

# Microsoft Teams — where the daily run reports what it did.
#
# This must be the HTTP-trigger URL of a tenant-owned Power Automate / Teams **Workflow**,
# not an old Office 365 connector webhook. Microsoft disabled connector webhooks between
# 2026-05-18 and 2026-05-22; a connector URL here fails silently, because a notifier that
# can fail its caller is worse than one that cannot.
#
# Restrict the trigger to a single identity and give the workflow at least two
# organisation-controlled co-owners. The URL is a bearer credential in URL clothing —
# anyone holding it can post into the channel.
TEAMS_WEBHOOK_URL=

# The daily editorial slot. The hour is local to the timezone below, and the run is keyed
# on the *local* date. The tick asks "is today's slot due and unclaimed", so a process that
# was asleep at the slot hour still runs the day's slot when it wakes.
ENABLE_SCHEDULER=false
ENABLE_AUTONOMOUS=false
DAILY_SLOT_HOUR=9
DAILY_SLOT_TIMEZONE=Asia/Kolkata
DAILY_TICK_MINUTES=30

# Where a Teams card's link points — this app's own web UI. Not a credential.
PIXII_BASE_URL=http://localhost:3000

# The publishing kill switch. Off by default, and that default is the feature: schedule,
# publish-now and cancel exist in the code and do nothing until this is deliberately true,
# and turning it off again removes the capability without a code rollback.
#
# It stops external publication commands only — generation, review and pushing a draft to
# Zernio all continue.
#
# **Do not set this true anywhere but localhost, and not at all if a second person uses this
# instance.** There is no authentication: anyone who can reach the API can publish. See
# docs/adr/0002-human-publication-authority.md for the boundary this relies on and the
# conditions that void it.
PUBLISHING_ENABLED=false

# The asset id of the brand logo, so extracted layouts pin it instead of drawing it.
# Upload the logo via POST /assets, then put the returned id here. Not a credential.
BRAND_LOGO_ASSET_ID=

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
